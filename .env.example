# Copier en .env (non versionné) pour surcharger les valeurs par défaut de compose.yaml.

# Port HTTPS publié par edge sur l'hôte. 443 par défaut ; 8443 par exemple avec Docker rootless
# ou si 443 est déjà pris (la PoC est alors sur https://localhost:8443).
MEDHEAD_EDGE_PORT=443

# Étiquette des images construites localement (jamais "latest").
MEDHEAD_IMAGE_TAG=local

# Référentiel des spécialités lu par recommendation-service (embarqué dans l'image par défaut).
MEDHEAD_RECOMMENDATION_SERVICE_SPECIALTIES_FILE=file:/app/reference/specialties.json
