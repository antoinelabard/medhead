{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run generate:api",
    "generate:api": "node -e \"require('fs').rmSync('src/app/api/generated',{recursive:true,force:true})\" && openapi-generator-cli generate -i ../contracts/openapi/medhead-api.yaml -g typescript-angular -o src/app/api/generated -c openapi-generator.config.json",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@openapitools/openapi-generator-cli": "2.43.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
